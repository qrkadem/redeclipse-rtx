// Ray traced reflections (vkrt.cpp). Each surface smooth enough sends a ray along its reflection, sampled over its
// roughness. Where the ray lands on something the camera sees, that pixel of the lit scene is what it reflects;
// elsewhere the hit is lit here, from its texture, the ambient, the sun and the map's lights, the way the deferred
// shading lights the scene. Rays that leave the scene are misses, which GL fills in from the environment maps.
#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

#include "rtcommon.glsl"

layout(set = 0, binding = 3, rgba16f) uniform readonly image2D lit;       // the lit scene, before reflections
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outcolor; // the reflected light, a 1 for a hit
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outaux;   // x distance to the hit, 0 for a miss

void main()
{
    ivec2 size = imageSize(positions);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if(p.x >= size.x || p.y >= size.y) return;

    vec4 wp = imageLoad(positions, p), nr = imageLoad(normals, p);
    float rough = pc.fog.z >= 2.0 ? 0.0 : nr.w;
    if(wp.w <= 0.0 || rough >= pc.params.x)
    {
        imageStore(outcolor, p, vec4(0.0));
        imageStore(outaux, p, vec4(0.0));
        return;
    }
    vec3 n = normalize(nr.xyz), v = pc.campos.xyz - wp.xyz;
    float surfdist = length(v);
    v /= surfdist;
    uint seed = hash(uint(p.x) | (uint(p.y) << 16)) ^ hash(floatBitsToUint(pc.campos.w) + 0x9e3779b9u);

    float alpha = rough*rough;
    vec3 d = reflect(-v, n);
    if(alpha >= 1.0e-3)
    {
        vec3 t, b;
        basis(n, t, b);
        vec3 h = sampleggx(vec3(dot(v, t), dot(v, b), dot(v, n)), alpha, vec2(rnd(seed), rnd(seed)));
        vec3 rd = reflect(-v, t*h.x + b*h.y + n*h.z);
        if(dot(rd, n) > 0.0) d = rd;
    }
    vec3 o = wp.xyz + n*(0.05 + surfdist*0.001);
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, scene, gl_RayFlagsOpaqueEXT, 0xFFu, o, 0.0, d, pc.params.y);
    while(rayQueryProceedEXT(rq)) {}
    if(rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT)
    {
        imageStore(outcolor, p, vec4(0.0));
        imageStore(outaux, p, vec4(0.0));
        return;
    }
    float hitt = rayQueryGetIntersectionTEXT(rq, true);
    vec3 hitpos = o + d*hitt;

    // what the camera sees there, if it sees the same spot, fading out towards the screen's edges
    float onscreen = 0.0;
    vec3 seen = vec3(0.0);
    vec4 clip = pc.viewproj * vec4(hitpos, 1.0);
    if(clip.w > 0.0)
    {
        vec2 sp = (clip.xy/clip.w*0.5 + 0.5)*vec2(size);
        if(sp.x >= 0.0 && sp.y >= 0.0 && sp.x < float(size.x) && sp.y < float(size.y))
        {
            ivec2 q = ivec2(sp);
            vec4 qp = imageLoad(positions, q);
            if(qp.w > 0.0 && distance(qp.xyz, hitpos) < 0.5 + 0.01*clip.w)
            {
                vec2 edge = min(sp, vec2(size) - sp)/vec2(size);
                onscreen = smoothstep(0.0, 0.05, min(edge.x, edge.y));
                seen = imageLoad(lit, q).rgb;
            }
        }
    }
    vec3 color = seen;
    if(onscreen < 1.0)
    {
        vec3 shaded = shade(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true), rayQueryGetIntersectionPrimitiveIndexEXT(rq, true),
            rayQueryGetIntersectionBarycentricsEXT(rq, true), rayQueryGetIntersectionObjectToWorldEXT(rq, true),
            hitpos, d, hitt, pc.params.z*surfdist, pc.params.z + alpha, true, true, seed);
        color = mix(shaded, seen, onscreen);
    }
    if(pc.fog.z == 1.0) color = vec3(1.0 - onscreen, onscreen, 0.0);
    // what can't be told apart from no light is none, so nothing undefined reaches the history
    if(any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
    imageStore(outcolor, p, vec4(min(color, vec3(64.0)), 1.0));
    imageStore(outaux, p, vec4(hitt, 0.0, 0.0, 0.0));
}
